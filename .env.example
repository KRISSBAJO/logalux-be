# Copy to .env and fill in. Never commit .env.

# Where the API listens inside the container / locally
PORT=18080
APP_ENV=development

# Postgres. Compose fills these for the api container; for local `go run` use the host port 15433.
POSTGRES_USER=logaluxe
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=logaluxe
DATABASE_URL=postgres://logaluxe:change-me-locally@127.0.0.1:15433/logaluxe?sslmode=disable

# Redis (jobs and caches, phase 1)
REDIS_URL=redis://127.0.0.1:16380

# Admin console. The Next.js server sends this as a Bearer token. Long random string.
ADMIN_TOKEN=change-me-long-random

# First admin account. Created once, on a start where no admin exists. Change the password after first sign-in.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-at-least-10-chars

# Web origin allowed to call the API from the browser
CORS_ORIGIN=http://localhost:3100,http://localhost:8097

# Payments. Leave blank until you have keys; the API runs in simulation mode without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Messaging. Blank = messages are logged, not sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TERMII_API_KEY=
RELYKIT_API_KEY=

# Seed sample data on first start (dev only)
SEED=true

# Image storage for site images uploaded in the admin console. The bucket can stay
# private: the API reads the images and serves them. The key needs s3:PutObject,
# s3:GetObject and s3:DeleteObject on the bucket.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email: password resets, support replies, gift cards and bulk messages.
# MAIL_PROVIDER is resend, smtp or log. With log, messages are written to the API log and not sent.
MAIL_PROVIDER=log
MAIL_FROM=LogaLuxe <noreply@yourdomain.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Public address of the website. Links in emails point here.
WEB_URL=http://localhost:3100

# Merchant web. With SEED=true, each sample business gets an owner who can sign in at
# /business/signin as <handle>@logaluxe.test (for example ada@logaluxe.test) with this password.
# Leave empty in production.
MERCHANT_DEMO_PASSWORD=

# Payout providers. Without a key, payout accounts and payouts run in simulation and say so.
# STRIPE_SECRET_KEY turns on Stripe Connect onboarding for US businesses.
# PAYSTACK_SECRET_KEY turns on bank checks and transfer recipients for Nigerian businesses.
STRIPE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Text messages and WhatsApp. Twilio texts numbers outside Nigeria, Termii texts Nigerian ones, and
# WhatsApp goes through Twilio. Keys alone send nothing: an admin switches each feature on in the
# console, under Features. TWILIO_WHATSAPP_FROM is the WhatsApp sender Twilio gave you, like
# whatsapp:+14155238886 (the sandbox number, or your approved business number).
TWILIO_WHATSAPP_FROM=
TWILIO_FROM_NUMBER=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_FROM=

# Signs the events Stripe sends to /v1/webhooks/stripe (Paystack signs with its secret key).
STRIPE_WEBHOOK_SECRET=

# Per-connection limits on sign-in, sign-up, reset emails, codes, bookings and orders. On by default.
# Set to off only for the end-to-end suites, which make many accounts from one address.
RATE_LIMITS=on

# A long random value shared with the web app (the same name in its environment). With it, the API
# believes the visitor address the web app passes on, so limits count per person and not per web server.
# Required in production; without it there, every visitor shares the web server's limit.
WEB_API_KEY=

# The API's own public address (for example https://api.yourdomain.com). Calendar subscription links are built from it.
# Google Calendar and others fetch those links from the internet, so they only work once this is a public https address.
API_PUBLIC_URL=
